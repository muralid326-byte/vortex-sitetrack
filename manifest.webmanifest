{
  "name": "Vortex SiteTrack",
  "short_name": "SiteTrack",
  "description": "Site resource and manpower tracking for Vortex Engineering",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFFFF",
